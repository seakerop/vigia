# Copia este fichero a .env (gitignorado) para correr el cron en local.
# Las mismas variables van en Vercel (para la API) y en GitHub Secrets (para
# el workflow del cron). Nada de esto se commitea jamás.

# Token personal de la API: una cadena larga aleatoria cualquiera. Es la misma
# que pegas una vez en Ajustes dentro de la app.
VIGIA_TOKEN=

# Upstash Redis (REST): crea una base gratuita en upstash.com y copia ambos
# valores de la pestaña "REST API". Sin ellos, en local se usa un fichero
# .data/dev-store.json como almacén de mentira.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot de Telegram: créalo hablando con @BotFather (te da el token), mándale
# un mensaje cualquiera a tu bot y saca tu chat_id de
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: URL del proxy de Yahoo ya desplegado, como respaldo por si Yahoo
# rechaza las IPs de los runners de GitHub.
# YAHOO_PROXY_URL=https://vigia.vercel.app/api/yahoo
